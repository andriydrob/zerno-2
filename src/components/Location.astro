---
const hours = [
  { day: "Пн – Пт", time: "8:00 – 20:00" },
  { day: "Сб – Нд", time: "9:00 – 20:00" },
];

const ADDRESS = "вул. Січових Стрільців, 12, Київ";
const seatsTotal = 32;
const seatsFree = 11;
---

<section id="location" class="border-t border-slate-border">
  <div class="max-w-content mx-auto px-6 md:px-10 py-20 md:py-28">
    <p class="section-label mb-4">Локація</p>
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">
      <div>
        <h2
          class="text-3xl md:text-[2.5rem] leading-tight text-cream font-semibold mb-8"
        >
          Заходьте, ми поруч
        </h2>

        <dl class="space-y-6 text-[16px]">
          <div>
            <dt class="text-sm text-cream/40 mb-1">Адреса</dt>
            <dd class="text-cream/90">{ADDRESS}</dd>
          </div>
          <div>
            <dt class="text-sm text-cream/40 mb-1">Години роботи</dt>
            <dd class="space-y-1">
              {
                hours.map((row) => (
                  <div class="flex justify-between max-w-xs text-cream/80">
                    <span class="text-cream/50">{row.day}</span>
                    <span>{row.time}</span>
                  </div>
                ))
              }
            </dd>
          </div>
          <div>
            <dt class="text-sm text-cream/40 mb-1">Контакти</dt>
            <dd class="text-cream/80">
              <a
                href="tel:+380441234567"
                class="hover:text-lime transition-colors">+38 (044) 123-45-67</a
              >
              <br />
              <a
                href="mailto:hello@zerno.coffee"
                class="hover:text-lime transition-colors">hello@zerno.coffee</a
              >
            </dd>
          </div>
        </dl>

        <a
          href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(ADDRESS)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-lime px-6 py-3 text-[15px] font-semibold text-slate hover:shadow-glow transition-shadow"
        >
          Прокласти маршрут
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>

      <div
        class="rounded-3xl overflow-hidden border border-slate-border aspect-[4/3] md:aspect-auto md:h-full relative"
      >
        <iframe
          title="Мапа розташування Зерно"
          src={`https://maps.google.com/maps?q=${encodeURIComponent(ADDRESS)}&t=&z=15&ie=UTF8&iwloc=&output=embed`}
          class="w-full h-full min-h-[360px] grayscale invert-[0.92] contrast-[0.85] hue-rotate-180"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        <div
          class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-white/5 rounded-3xl"
        >
        </div>
      </div>
    </div>
  </div>
</section>
