---
import StatusBadge from './StatusBadge.tsx';

const tags = ['⚡ Fast Wi-Fi 200 Mbps', '🐶 Pet-Friendly', '🌱 Oat Milk Default'];
---

<section id="home" class="max-w-content mx-auto px-6 md:px-10 pt-16 pb-24 md:pt-24 md:pb-32">
  <div class="grid lg:grid-cols-2 gap-16 lg:gap-12 items-center">
    
    <div class="animate-rise">
      <StatusBadge client:load />

      <h1 class="mt-7 text-[2.75rem] leading-[1.05] md:text-7xl md:leading-[1.02] font-semibold text-cream max-w-3xl text-balance">
        Кава. Простір.
        <span class="text-lime">Натхнення.</span>
      </h1>

      <p class="mt-7 max-w-lg text-lg leading-relaxed text-cream/60">
        Зерно смажимо самі невеликими партіями. Тихе місце попрацювати вранці
        й видихнути ввечері — з хорошою кавою в руці.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#menu"
          class="inline-flex items-center rounded-full bg-lime px-6 py-3 text-[15px] font-semibold text-slate hover:shadow-glow transition-shadow"
        >
          Переглянути меню
        </a>
        <a
          href="#location"
          class="inline-flex items-center rounded-full border border-slate-border px-6 py-3 text-[15px] text-cream/80 hover:border-cream/40 transition-colors"
        >
          вул. Січових Стрільців, 12
        </a>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        {tags.map((tag) => (
          <span class="pill bg-slate-soft/60 text-cream/70 hover:-translate-y-0.5 hover:border-lime/40 transition-all">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <div class="animate-rise hidden lg:flex w-full justify-end">
      <div class="relative w-full max-w-lg aspect-[4/3] rounded-3xl overflow-hidden shadow-lg border border-slate-border/50 bg-slate-soft/30">
        <img
          src="/public/coffee.jpeg" 
          alt="Атмосфера кав'ярні Зерно"
          class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        />
      </div>
    </div>

  </div>
</section>